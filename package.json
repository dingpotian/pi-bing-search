{
  "name": "pi-bing-search",
  "version": "1.0.0",
  "type": "module",
  "description": "Pi extension: Bing web search via a real Chromium browser (Playwright)",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "typescript",
    "bing",
    "search",
    "web-search",
    "playwright"
  ],
  "author": "dingpotian",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dingpotian/pi-bing-search.git"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "index.ts",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": ["./index.ts"]
  },
  "scripts": {
